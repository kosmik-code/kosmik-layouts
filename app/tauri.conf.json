{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kosmik Layouts",
  "mainBinaryName": "kosmik-layouts",
  "identifier": "com.kosmik.layouts",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Kosmik",
    "homepage": "https://github.com/kosmik-code/kosmik-layouts",
    "copyright": "© 2026 Kosmik. MIT license.",
    "category": "Utility",
    "shortDescription": "Per-game OBS layouts in one scene",
    "longDescription": "Your OBS scene rearranges itself for each game you play. Runs in the tray, watches which game is open and moves your sources to the layout you saved for it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCREJFNzEzMDQ3MTA0QzkKUldUSkJIRUVFK2ZiMjQ5QTVDMUhLSGlKR2xmbkk1RWJoYjR5bUN4RjYvSG95U2ZReWpaZ2JUbUIK",
      "endpoints": [
        "https://github.com/kosmik-code/kosmik-layouts/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
